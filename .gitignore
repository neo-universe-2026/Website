# Dependencies
node_modules/

# Build outputs
target/
wasm/pkg/
wasm/target/

# Local server cache
.cache/

# Dataset videos are downloaded by scripts/fetch-videos.sh at build/dev time
# (NASA's servers don't send CORS headers, so the sonificator needs local
# copies). co2.mp4 stays committed as the ready-to-sonify fallback.
videos/*
!videos/co2.mp4

# Demo audio files
demos/

# Generated files
package-lock.json
pnpm-lock.yaml

# IDE
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

# Windows
Thumbs.db

# Nix
/nix/
result/

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# OS files
*.bak
*.tmp
